# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_APPLICATION_CREDENTIALS_JSON: JSON string of Google Cloud Service Account key for Translation, TTS, and STT APIs.
GOOGLE_APPLICATION_CREDENTIALS_JSON='{}'

# GOOGLE_CLOUD_PROJECT: The project ID for Google Cloud services (Default: promptwar-2-495019)
GOOGLE_CLOUD_PROJECT="promptwar-2-495019"
